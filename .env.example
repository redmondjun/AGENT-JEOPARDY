# Shared hackathon host configuration.
# Copy to .env, paste the team key shared privately, then: source .env

# HTTPS, and NO port number — the event host terminates TLS on 443. Don't turn
# this into http://...:8000; that path also works, and it would put your team
# key on the wire in cleartext.
export JEOPARDY_BASE_URL=https://hackathon.gradial.dev
export TEAM_API_KEY=team_REPLACE_WITH_YOUR_KEY

# The event's Claude proxy. Your team key IS the API key. There is no other
# model access, and the proxy forces one model no matter what you request.
export ANTHROPIC_BASE_URL=$JEOPARDY_BASE_URL/anthropic
export ANTHROPIC_API_KEY=$TEAM_API_KEY

# --- optional team-agent knobs implemented in main.py ---
# Script mode loads `.env` automatically; shell exports still take precedence.
# Nothing else here is magic: grep main.py.
# export VERBOSE=1            # print the prompt, the model's full reply, and
#                             # the raw submit response for every tile
# export TASK_FILTER=PR-W5,PR-C5  # attempt exactly these tiles, in this order
#                             # practice ids are PR-<letter><tier>: PR-A1..PR-W5
# export MAX_TILES=3          # fixed total tile sample; unset means all tiles
#                             # with the team solver, 3 with naive fallback
# export MAX_WORKERS=6        # concurrent I/O-heavy tile workers; lower if
#                             # proxy traffic is consistently rate-delayed
# export MAX_SOLVE_ATTEMPTS=3 # terminal failure after repeated solver defects
# export POLL_SECONDS=2       # normal board refresh interval
# export TASK_TIMEOUT_SECONDS=180 # hard orchestration deadline per tile;
#                             # allows multi-step web/code attempts to finish
# export HEARTBEAT_INTERVAL_SECONDS=30  # unchanged-state log interval
# export TASK_PREFETCH=1      # warm upcoming task prompts without model calls
# export PREFETCH_WORKERS=2   # separate bounded task-detail fetch workers
# export PREFETCH_LOOKAHEAD=12 # next two six-worker waves
# export PREFETCH_TIMEOUT_SECONDS=10
# export PREFETCH_JOIN_SECONDS=0.25
# export MIN_CONFIDENCE=0.70  # matches tracked agent.env deployment default;
#                             # verification down-clamps unsafe candidates
# export TIER_ONE_MIN_CONFIDENCE=0.65 # scored 100-point threshold, calibrated
#                             # from 7/7 correct verified practice candidates
# export TIER_ONE_POINTS=100  # point value receiving the tier-one threshold
# export SUBMISSION_INTERVAL_SECONDS=3.1  # must remain >= server's 3s limit
# export RUN_FOREVER=1        # override auto mode (team solver=yes, fallback=no)
# export BASELINE_CONFIDENCE=0  # keep zero unless deliberately testing submits
